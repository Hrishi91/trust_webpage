rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true
        && exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }
    // Public content: must be explicitly published and explicitly not deleted.
    function isLive() { return resource.data.published == true && resource.data.deleted == false; }
    function albumLive(a) { return a.published == true && a.deleted == false; }
    function hasDeletedFlag() { return request.resource.data.deleted is bool; }
    // Theme name (Phase 5). Anything else must never reach <html data-theme>.
    function validDesign() {
      return !('design' in request.resource.data)
        || request.resource.data.design in ['siddhi', 'mukha', 'dhokra', 'atreyee', 'bangarh'];
    }
    // Phase 6: settings.designOverrides is a subset of the theme's colour tokens as '#rrggbb'.
    // Rules cannot iterate a map's values, so every whitelisted key is checked individually —
    // absent keys are fine, present keys must be a hex colour string.
    function hexColor(v) { return v is string && v.matches('^#[0-9a-fA-F]{6}$'); }
    function validOverrideValues(o) {
      return o is map
        && o.keys().hasOnly(['bg','bg2','ivory','ivory2','ink','muted','sindoor','pitambar','durva','gold','cta','ctaInk','card','heroAccent','tickerInk'])
        && (!('bg' in o) || hexColor(o.bg))
        && (!('bg2' in o) || hexColor(o.bg2))
        && (!('ivory' in o) || hexColor(o.ivory))
        && (!('ivory2' in o) || hexColor(o.ivory2))
        && (!('ink' in o) || hexColor(o.ink))
        && (!('muted' in o) || hexColor(o.muted))
        && (!('sindoor' in o) || hexColor(o.sindoor))
        && (!('pitambar' in o) || hexColor(o.pitambar))
        && (!('durva' in o) || hexColor(o.durva))
        && (!('gold' in o) || hexColor(o.gold))
        && (!('cta' in o) || hexColor(o.cta))
        && (!('ctaInk' in o) || hexColor(o.ctaInk))
        && (!('card' in o) || hexColor(o.card))
        && (!('heroAccent' in o) || hexColor(o.heroAccent))
        && (!('tickerInk' in o) || hexColor(o.tickerInk));
    }
    function validOverrides() {
      return !('designOverrides' in request.resource.data) || validOverrideValues(request.resource.data.designOverrides);
    }
    // Phase 6: settings.fonts — only the four families the site actually loads, or '' meaning
    // "use the theme's default" (the admin UI saves '' for an unset select).
    function validFontValues(f) {
      return f is map
        && f.keys().hasOnly(['display', 'body'])
        && (!('display' in f) || f.display in ['', 'Baloo Da 2', 'Hind Siliguri', 'Tiro Bangla', 'Atma'])
        && (!('body' in f) || f.body in ['', 'Baloo Da 2', 'Hind Siliguri', 'Tiro Bangla', 'Atma']);
    }
    function validFonts() {
      return !('fonts' in request.resource.data) || validFontValues(request.resource.data.fonts);
    }
    // Phase 6: settings.homeSections — rules cannot validate list elements, only that it is a
    // list within a sane size; each element's {key, on} shape is validated client-side (js/sections.js).
    function validHomeSections() {
      return !('homeSections' in request.resource.data)
        || (request.resource.data.homeSections is list && request.resource.data.homeSections.size() <= 11);
    }
    // Phase 6 Task 6: settings.social — each of the four links is either '' or an https:// URL.
    // A non-https value (javascript:, data:, plain http) must never round-trip back out as an
    // <a href> (js/shell.js's footer already gates every link through httpsUrl() too — this is
    // the write-side half of that same guarantee, not a redundant check).
    function httpsOrEmpty(v) { return v is string && (v == '' || v.matches('^https://.*')); }
    // Phase 7 Task 1: settings.trustees — a list of {name,role} shown on trust.html. Rules cannot
    // validate list elements (same limitation as validHomeSections()); a sane size cap is all
    // that's enforced server-side, same reasoning as homeSections.
    function validTrustees() {
      return !('trustees' in request.resource.data)
        || (request.resource.data.trustees is list && request.resource.data.trustees.size() <= 20);
    }
    function validSocial() {
      return !('social' in request.resource.data) || (
        request.resource.data.social is map
        && request.resource.data.social.keys().hasOnly(['facebook', 'youtube', 'instagram', 'whatsappGroup'])
        && (!('facebook' in request.resource.data.social) || httpsOrEmpty(request.resource.data.social.facebook))
        && (!('youtube' in request.resource.data.social) || httpsOrEmpty(request.resource.data.social.youtube))
        && (!('instagram' in request.resource.data.social) || httpsOrEmpty(request.resource.data.social.instagram))
        && (!('whatsappGroup' in request.resource.data.social) || httpsOrEmpty(request.resource.data.social.whatsappGroup))
      );
    }

    match /settings/site {
      allow read: if true;
      allow create, update: if isAdmin() && validDesign() && validOverrides() && validFonts() && validHomeSections() && validSocial() && validTrustees();
      allow delete: if false;
    }

    // Phase 6: admin-editable string/media overrides. Fixed doc ids only — no arbitrary docs
    // under content/*, and never hard-deletable (nothing else reads content/* to check a flag).
    match /content/{doc} {
      allow read: if true;
      allow create, update: if isAdmin() && doc in ['strings', 'media'];
      allow delete: if false;
    }

    match /history/{id} {
      allow read: if isAdmin() || isLive();
      allow create, update: if isAdmin() && hasDeletedFlag();
      allow delete: if false;
    }

    // Phase 7 Task 1: pages/{id} — privacy, refund, trust, contact, faq, news, downloads,
    // notfound. Fixed ids (js/page-defaults.js), same published+!deleted shape as history; no
    // `order` field (not a reorderable list) but the shape check doesn't care.
    match /pages/{id} {
      allow read: if isAdmin() || isLive();
      allow create, update: if isAdmin() && hasDeletedFlag() && id in ['privacy','refund','trust','contact','faq','news','downloads','notfound'];
      allow delete: if false;
    }

    match /events/{id} {
      allow read: if isAdmin() || isLive();
      allow create, update: if isAdmin() && hasDeletedFlag();
      allow delete: if false;
    }

    match /committee/{id} {
      allow read: if isAdmin() || (resource.data.isPublic == true && resource.data.deleted == false);
      allow create, update: if isAdmin() && hasDeletedFlag();
      allow delete: if false;
    }

    // Phase 6: culture cards — same published+deleted shape as history/events, not committee's
    // isPublic (culture has no "hide but keep" concept beyond the shared soft-delete).
    match /culture/{id} {
      allow read: if isAdmin() || isLive();
      allow create, update: if isAdmin() && hasDeletedFlag();
      allow delete: if false;
    }

    match /albums/{albumId} {
      allow read: if isAdmin() || isLive();
      allow create, update: if isAdmin() && hasDeletedFlag();
      allow delete: if false;

      match /photos/{photoId} {
        allow read: if isAdmin() || (
          resource.data.deleted == false &&
          albumLive(get(/databases/$(db)/documents/albums/$(albumId)).data)
        );
        allow create, update: if isAdmin() && hasDeletedFlag();
        allow delete: if false;
      }
    }

    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;   // console only
    }

    match /audit/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    function isMember() {
      return signedIn() && request.auth.token.phone_number is string
        && request.auth.token.phone_number.matches('^\\+[0-9]{10,14}$');
    }
    function myPhone() { return request.auth.token.phone_number; }
    // Rules cache get()/exists() by path within one evaluation, so calling me()
    // more than once for the same phone is a single billed read.
    function me() { return get(/databases/$(db)/documents/members/$(myPhone())).data; }
    function activeMember() {
      return isMember()
        && exists(/databases/$(db)/documents/members/$(myPhone()))
        && me().active == true && me().deleted == false;
    }

    match /donations/{id} {
      allow read: if isAdmin() || (resource.data.showOnWall == true && resource.data.deleted == false);
      allow create, update: if isAdmin() && hasDeletedFlag() && !('phone' in request.resource.data)
        && request.resource.data.keys().hasOnly(['donorName','amount','date','mode','receiptNo','year','isAnonymous','showOnWall','note','order','published','deleted','createdAt','updatedAt']);
      allow delete: if false;
    }
    match /transparency/{year} {
      allow read: if isAdmin() || isLive();
      allow create, update: if isAdmin() && hasDeletedFlag();
      allow delete: if false;
    }
    match /announcements/{id} {
      allow read: if isAdmin() || isLive();
      allow create, update: if isAdmin() && hasDeletedFlag();
      allow delete: if false;
    }
    match /members/{phone} {
      allow read: if isAdmin() || (isMember() && myPhone() == phone && resource.data.deleted == false);
      allow create, update: if isAdmin() && hasDeletedFlag();
      allow delete: if false;
    }
    // Intended: any ACTIVE member may read all published notices and the whole roster (spec §5);
    // memberPhones is therefore visible to all active members.
    match /notices/{id} {
      allow read: if isAdmin() || (activeMember() && isLive());
      allow create, update: if isAdmin() && hasDeletedFlag();
      allow delete: if false;
    }
    match /roster/{id} {
      allow read: if isAdmin() || (activeMember() && isLive());
      allow create, update: if isAdmin() && hasDeletedFlag();
      allow delete: if false;
    }

    // Phase 7 Task 7 (item 42): client-side error reports (js/errors.js). Create-only, no auth
    // required — any visitor's browser can throw. Bounded field sizes limit abuse from a hostile
    // client (App Check, owner-only, will gate this further); `at` must equal `request.time`, the
    // server-resolved value of the client's `serverTimestamp()` sentinel, so it can't be forged.
    // Read is admin-only (📜 লগ → ত্রুটি tab); never editable or hard-deletable, same as `audit`.
    match /errors/{id} {
      allow create: if request.resource.data.keys().hasOnly(['message', 'url', 'ua', 'stack', 'at'])
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.url is string && request.resource.data.url.size() <= 300
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 300
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 2000
        && request.resource.data.at == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Everything else is denied until its phase adds explicit rules + tests.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
